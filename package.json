{
	"name": "suu3-blog-next",
	"private": true,
	"description": "Next.js blog migrated from Gatsby",
	"version": "2.0.0",
	"author": "suu3",
	"dependencies": {
		"framer-motion": "^12.43.0",
		"gray-matter": "^4.0.3",
		"next": "^15.5.28",
		"next-themes": "^0.4.6",
		"prismjs": "^1.30.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"utterances-react": "^0.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@pandacss/dev": "^0.45.2",
		"@types/node": "^22.20.5",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"panda:codegen": "panda codegen",
		"panda:cssgen": "panda cssgen --outfile styled-system/styles.css",
		"predev": "pnpm panda:codegen && pnpm panda:cssgen",
		"prebuild": "pnpm panda:codegen && pnpm panda:cssgen",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"format": "biome format --write .",
		"lint:biome": "biome lint ."
	},
	"pnpm": {
		"overrides": {
			"esbuild@<=0.24.2": "^0.25.0",
			"postcss@<=8.5.22": "^8.5.23",
			"postcss-selector-parser@<6.1.5": "^6.1.5",
			"browserslist@<=4.28.6": "^4.28.7"
		}
	}
}
